OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JWT_SECRET=
JWT_ISSUER=simple-auth-server
CORS_ORIGINS=http://localhost:5174
RAG_INDEX_DIR=faiss_db/p1-complete   # P1 정식 인덱스. 베이스 실습 인덱스는 faiss_db
LLM_MODEL=gpt-4o
LLM_TIMEOUT_S=20
REWRITE_MODEL=gpt-4o-mini   # 검색어 재작성용 가벼운 모델
RAG_MAX_CONTEXT_CHARS=12000   # 답변 LLM 에 넣는 근거 블록 총 글자 수 상한
ASYNC_DB_URL=mysql+aiomysql://root:${DB_PASSWORD}@localhost:53301/sql_db?charset=utf8mb4   # 베이스 DB 연결 (현재 RAG 에서는 미사용)
