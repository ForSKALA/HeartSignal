# 루트 docker-compose.yml 용. 복사해서 .env 로 만든다 (커밋 금지): cp .env-example .env
# 키 이름만 둔다. 값은 .env 에만 채운다.

# 필수
DB_PASSWORD=
JWT_SECRET=                          # Java·Python 동일 값

# RAG·음성 (없어도 기동: 챗봇은 503, 경보는 문서 근거·템플릿으로 동작)
OPENAI_API_KEY=

# 시연 계정 비밀번호 (ENV_FILE=.env db/seed-demo-users.sh)
SEED_ADMIN_PASSWORD=
SEED_FOREMAN_PASSWORD=
SEED_WORKER_PASSWORD=

# 선택 (비우면 compose 기본값)
# JWT_ISSUER=simple-auth-server
# CORS_ORIGINS=http://localhost:5174
# LOGIN_REDIRECT_URL=/#/home
# COOKIE_SECURE=false
# LLM_MODEL=gpt-4o
# LLM_TIMEOUT_S=20
# REWRITE_MODEL=gpt-4o-mini
# RAG_INDEX_DIR=faiss_db/p1-complete
# RAG_MAX_CONTEXT_CHARS=12000
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
